# ============================================================
# CONFIGURACIÓN GENERAL DEL PROYECTO
# ============================================================

# Nombre del proyecto que aparecerá en la documentación de FastAPI.
PROJECT_NAME=MarketMap Analytics

# Descripción general del sistema.
PROJECT_DESCRIPTION=Sistema Web de Gestión Comercial con Mapa Interactivo y Análisis de Ventas

# Versión actual de la API.
PROJECT_VERSION=1.0.0


# ============================================================
# CONFIGURACIÓN DEL ENTORNO
# ============================================================

# Entorno de ejecución.
# Valores comunes:
# development
# production
# testing
ENVIRONMENT=development

# Activa o desactiva el modo depuración.
# En desarrollo puede ser true.
# En producción debe ser false.
DEBUG=true

# Prefijo general para los endpoints de la API.
# Nota:
# Actualmente main.py registra rutas sin este prefijo.
# Se conserva por si después quieres usar /api.
API_PREFIX=/api


# ============================================================
# CONFIGURACIÓN DEL FRONTEND
# ============================================================

# URL base del frontend Angular.
# Se usa para construir el enlace de recuperación de contraseña:
# http://localhost:4200/auth/reset-password?token=...
FRONTEND_URL=http://localhost:4200


# ============================================================
# CONFIGURACIÓN DE MONGODB ATLAS
# ============================================================

# URI de conexión a MongoDB Atlas.
#
# Importante:
# - No dejes <db_password>.
# - La contraseña debe coincidir con la configurada en Atlas.
# - Si la contraseña tiene caracteres especiales como @, #, %, /, :, ?, &, deben ir codificados para URL.
MONGODB_URI=mongodb+srv://thunder6321_db_user:Prueba123@cluster0.lhgd5me.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Nombre de la base de datos que usará el sistema.
# MongoDB Atlas la creará automáticamente cuando insertes el primer documento.
MONGODB_DATABASE=marketmap_analytics


# ============================================================
# CONFIGURACIÓN DE GOOGLE OAUTH
# ============================================================

# Client ID generado en Google Cloud Console.
# Se usa para validar los tokens de inicio de sesión con Google.
GOOGLE_CLIENT_ID=704307847467-h12qpn0l9ua7p1nthdgf0eb2d8o8sf64.apps.googleusercontent.com


# ============================================================
# CONFIGURACIÓN DE SEGURIDAD JWT
# ============================================================

# Clave secreta para firmar los tokens JWT.
# En producción debe cambiarse por una clave larga, privada y segura.
JWT_SECRET_KEY=change_this_secret_key_for_development

# Algoritmo utilizado para firmar los tokens JWT.
JWT_ALGORITHM=HS256

# Duración del token de acceso en minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Duración del token de refresco en días.
REFRESH_TOKEN_EXPIRE_DAYS=7


# ============================================================
# CONFIGURACIÓN DE CONTRASEÑAS
# ============================================================

# Longitud mínima permitida para contraseñas.
PASSWORD_MIN_LENGTH=8

# Obliga a que la contraseña tenga al menos una letra mayúscula.
PASSWORD_REQUIRE_UPPERCASE=true

# Obliga a que la contraseña tenga al menos una letra minúscula.
PASSWORD_REQUIRE_LOWERCASE=true

# Obliga a que la contraseña tenga al menos un número.
PASSWORD_REQUIRE_NUMBER=true

# Obliga a que la contraseña tenga al menos un carácter especial.
PASSWORD_REQUIRE_SPECIAL_CHARACTER=true

# Tiempo de vida del token de recuperación de contraseña, en minutos.
RESET_PASSWORD_EXPIRE_MINUTES=30


# ============================================================
# CONFIGURACIÓN DE CORREO SMTP
# ============================================================

# Servidor SMTP.
# Para Gmail normalmente se usa smtp.gmail.com.
SMTP_HOST=smtp.gmail.com

# Puerto SMTP.
# Para Gmail con STARTTLS normalmente se usa 587.
SMTP_PORT=587

# Correo que se usará para autenticar el envío.
SMTP_USERNAME=tu_correo@gmail.com

# Contraseña de aplicación del correo.
# En Gmail NO uses tu contraseña normal.
# Debes generar una contraseña de aplicación desde tu cuenta de Google.
SMTP_PASSWORD=tu_app_password

# Correo que aparecerá como remitente.
SMTP_FROM_EMAIL=tu_correo@gmail.com

# Nombre que aparecerá como remitente.
SMTP_FROM_NAME=MarketMap Analytics

# Indica si se usará STARTTLS.
SMTP_USE_TLS=true


# ============================================================
# CONFIGURACIÓN CORS
# ============================================================

# Lista de orígenes permitidos para consumir la API.
# Aquí se permite Angular en desarrollo.
#
# Importante:
# Debe mantenerse como arreglo JSON porque config.py lo lee como list[str].
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]